// The program's icon and version, as Explorer and the taskbar show them.
// IDI_ICON1 is also what Qt gives its windows when none is set.
#include <winver.h>

#include "version.h"

IDI_ICON1 ICON "flx.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION FLX_VERSION_NUMBERS
PRODUCTVERSION FLX_VERSION_NUMBERS
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Felix Jablonka"
            VALUE "FileDescription", "FLX Film Lab"
            VALUE "FileVersion", FLX_VERSION_TEXT
            VALUE "InternalName", "FLXFilmLab"
            VALUE "LegalCopyright", "Felix Jablonka. GPL-3.0; the icon all rights reserved."
            VALUE "OriginalFilename", "FLXFilmLab.exe"
            VALUE "ProductName", "FLX Film Lab"
            VALUE "ProductVersion", FLX_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
