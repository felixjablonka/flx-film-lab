#version 440
// Capture sharpening's local detail: the square of how far the luminance is
// from its 3x3 mean, which the 3x3 box then averages. RawDetail's
// sharpenCapture.

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform sampler2D observed;
layout(binding = 1) uniform sampler2D mean;
layout(binding = 2, r32f) uniform writeonly image2D dst;

void main()
{
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(dst);
    if (gid.x >= size.x || gid.y >= size.y) return;
    float d = texelFetch(observed, gid, 0).r - texelFetch(mean, gid, 0).r;
    imageStore(dst, gid, vec4(d * d, 0.0, 0.0, 1.0));
}
