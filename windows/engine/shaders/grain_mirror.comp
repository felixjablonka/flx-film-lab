#version 440
// The grain turned the other way: the clean density less the grain.
// flx.metal grain_mirror.

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform sampler2D clean;
layout(binding = 1) uniform sampler2D grainy;
layout(binding = 2, rgba32f) uniform writeonly image2D dst;

void main()
{
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(dst);
    if (gid.x >= size.x || gid.y >= size.y) return;
    imageStore(dst, gid, vec4(2.0 * texelFetch(clean, gid, 0).rgb - texelFetch(grainy, gid, 0).rgb, 1.0));
}
