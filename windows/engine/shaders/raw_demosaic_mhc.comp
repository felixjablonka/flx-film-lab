#version 440
// Malvar, He and Cutler's demosaic of a Bayer mosaic, balanced and in float:
// bilinear interpolation corrected by the Laplacian of the channel that is
// there, 5x5, the edges mirrored onto the same colour. RawDecoder's
// demosaicMHC.

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform sampler2D mosaic;
layout(binding = 1, rgba32f) uniform writeonly image2D dst;
layout(std140, binding = 2) uniform Pattern {
    ivec4 cfa;              // the 2x2 pattern, [0][0] [0][1] [1][0] [1][1]: 0 R, 1 G, 2 B
} u;

int colourAt(int row, int column)
{
    int i = row * 2 + column;
    return i == 0 ? u.cfa.x : i == 1 ? u.cfa.y : i == 2 ? u.cfa.z : u.cfa.w;
}

float at(int x, int y, ivec2 size)
{
    if (x < 0) x = -x; else if (x >= size.x) x = 2 * (size.x - 1) - x;
    if (y < 0) y = -y; else if (y >= size.y) y = 2 * (size.y - 1) - y;
    return texelFetch(mosaic, ivec2(x, y), 0).r;
}

void main()
{
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(dst);
    if (gid.x >= size.x || gid.y >= size.y) return;
    int x = gid.x, y = gid.y;
    int c = colourAt(y & 1, x & 1);
    float v = at(x, y, size);
    float n = at(x, y - 1, size), s = at(x, y + 1, size), e = at(x + 1, y, size), w = at(x - 1, y, size);
    float nn = at(x, y - 2, size), ss = at(x, y + 2, size), ee = at(x + 2, y, size), ww = at(x - 2, y, size);
    float ne = at(x + 1, y - 1, size), nw = at(x - 1, y - 1, size), se = at(x + 1, y + 1, size), sw = at(x - 1, y + 1, size);
    vec3 rgb;
    if (c == 1) {
        // green: red and blue from the row and the column
        float row = (5.0 * v + 4.0 * (e + w) - (ne + nw + se + sw) - (ee + ww) + 0.5 * (nn + ss)) / 8.0;
        float column = (5.0 * v + 4.0 * (n + s) - (ne + nw + se + sw) - (nn + ss) + 0.5 * (ee + ww)) / 8.0;
        bool redInRow = colourAt(y & 1, (x + 1) & 1) == 0;
        rgb = vec3(redInRow ? row : column, v, redInRow ? column : row);
    } else {
        float green = (4.0 * v + 2.0 * (n + s + e + w) - (nn + ss + ee + ww)) / 8.0;
        float other = (6.0 * v + 2.0 * (ne + nw + se + sw) - 1.5 * (nn + ss + ee + ww)) / 8.0;
        rgb = c == 0 ? vec3(v, green, other) : vec3(other, green, v);
    }
    imageStore(dst, gid, vec4(rgb, 1.0));
}
