#version 440
// The colour noise's guided filter at half size: the guide's and the two
// chromas' means over 2 x 2, and the products whose means the filter takes.
// RawDetail's reduceColourNoise.

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform sampler2D src;
layout(binding = 1) uniform sampler2D guide;        // full size
layout(binding = 2, rgba32f) uniform writeonly image2D first;    // I, I^2, c1, c2
layout(binding = 3, rgba32f) uniform writeonly image2D second;   // I c1, I c2

float cubeRoot(float v) { return sign(v) * pow(abs(v), 1.0 / 3.0); }

void main()
{
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(first);
    if (gid.x >= size.x || gid.y >= size.y) return;
    ivec2 full = textureSize(src, 0);
    float g = 0.0, a = 0.0, b = 0.0;
    int count = 0;
    for (int dy = 0; dy < 2; ++dy)
        for (int dx = 0; dx < 2; ++dx) {
            ivec2 p = 2 * gid + ivec2(dx, dy);
            if (p.x >= full.x || p.y >= full.y)
                continue;
            vec3 c = texelFetch(src, p, 0).rgb;
            float i = texelFetch(guide, p, 0).r;
            g += i;
            a += cubeRoot(c.r) - i;
            b += cubeRoot(c.b) - i;
            ++count;
        }
    g /= float(count);
    a /= float(count);
    b /= float(count);
    imageStore(first, gid, vec4(g, g * g, a, b));
    imageStore(second, gid, vec4(g * a, g * b, 0.0, 0.0));
}
