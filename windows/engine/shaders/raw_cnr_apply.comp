#version 440
// The guided filter at full size: a and b's window means brought up from
// half size, linear between, and applied to the full-size guide; the
// guide, the luminance of the cube roots, kept as it is. RawDetail's
// reduceColourNoise.

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform sampler2D ab;           // half size: means of a1, b1, a2, b2
layout(binding = 1) uniform sampler2D guide;        // full size
layout(binding = 2, rgba32f) uniform writeonly image2D dst;

const vec3 kLuma = vec3(0.2627, 0.6780, 0.0593);

void main()
{
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(dst);
    if (gid.x >= size.x || gid.y >= size.y) return;
    ivec2 halfSize = textureSize(ab, 0);
    float sy = clamp((float(gid.y) - 0.5) / 2.0, 0.0, float(halfSize.y - 1));
    float sx = clamp((float(gid.x) - 0.5) / 2.0, 0.0, float(halfSize.x - 1));
    int y0 = int(sy), y1 = min(y0 + 1, halfSize.y - 1), x0 = int(sx), x1 = min(x0 + 1, halfSize.x - 1);
    float fy = sy - float(y0), fx = sx - float(x0);
    vec4 top = texelFetch(ab, ivec2(x0, y0), 0) * (1.0 - fx) + texelFetch(ab, ivec2(x1, y0), 0) * fx;
    vec4 bottom = texelFetch(ab, ivec2(x0, y1), 0) * (1.0 - fx) + texelFetch(ab, ivec2(x1, y1), 0) * fx;
    vec4 k = top * (1.0 - fy) + bottom * fy;
    float i = texelFetch(guide, gid, 0).r;
    float r3 = i + k.x * i + k.y, b3 = i + k.z * i + k.w;
    float g3 = (i - kLuma.x * r3 - kLuma.z * b3) / kLuma.y;
    imageStore(dst, gid, vec4(r3 * r3 * r3, g3 * g3 * g3, b3 * b3 * b3, 1.0));
}
