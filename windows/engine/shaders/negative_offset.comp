#version 440
// The developed negative with a density added to each record: for the look's
// bakes alone (FilmRenderer::setNegativeOffset), which read how the print
// answers a change in each layer's density, for the grain laid on clips.
// flx.metal negative_offset.

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform sampler2D src;
layout(binding = 1, rgba32f) uniform writeonly image2D dst;
layout(std140, binding = 2) uniform Offset {
    vec4 offset;           // the density added to each record, c m y
} u;

void main()
{
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(dst);
    if (gid.x >= size.x || gid.y >= size.y) return;
    vec4 v = texelFetch(src, gid, 0);
    imageStore(dst, gid, vec4(v.rgb + u.offset.rgb, v.a));
}
