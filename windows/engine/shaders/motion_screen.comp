#version 440
// The graded frame for the screen: display light to sRGB, 8 bits, rounded
// here so every GPU lands on the same levels.

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform sampler2D src;
layout(binding = 1, rgba8) uniform writeonly image2D dst;

void main()
{
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(dst);
    if (gid.x >= size.x || gid.y >= size.y) return;
    vec3 c = clamp(texelFetch(src, gid, 0).rgb, 0.0, 1.0);
    c = mix(1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, c * 12.92, lessThanEqual(c, vec3(0.0031308)));
    imageStore(dst, gid, vec4(floor(c * 255.0 + 0.5) / 255.0, 1.0));
}
