#version 440
// The mean of the prints of the grain and of its mirror: the grain-free print
// and the even part of the print's response to the grain, its mean shift.
// flx.metal grain_even_mean.

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform sampler2D a;
layout(binding = 1) uniform sampler2D b;
layout(binding = 2, rgba32f) uniform writeonly image2D dst;

void main()
{
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(dst);
    if (gid.x >= size.x || gid.y >= size.y) return;
    imageStore(dst, gid, vec4(0.5 * (texelFetch(a, gid, 0).rgb + texelFetch(b, gid, 0).rgb), 1.0));
}
