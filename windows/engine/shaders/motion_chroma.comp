#version 440
// An export's chroma: Cb and Cr at video levels, 10 bits, BT.709, sited as
// the files are tagged (left): across, a [1 2 1] filter centred on the even
// luma column a sample shares; down, for 4:2:0, the average of the two rows
// it sits between.

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform sampler2D src;
layout(binding = 1, r16) uniform writeonly image2D cbPlane;
layout(binding = 2, r16) uniform writeonly image2D crPlane;
layout(std140, binding = 3) uniform Export {
    vec4 coding;           // x: 1 / gamma; y: 1 for the sRGB curve instead
    ivec4 chroma;          // x, y: luma pixels per chroma sample's log2
} u;

// display light to the display's curve: a power, or sRGB's
vec3 encoded(vec3 light)
{
    light = clamp(light, 0.0, 1.0);
    if (u.coding.y > 0.5)
        return mix(12.92 * light, 1.055 * pow(light, vec3(1.0 / 2.4)) - 0.055, step(vec3(0.0031308), light));
    return pow(light, vec3(u.coding.x));
}

vec2 colourAt(ivec2 p, ivec2 full)
{
    p = clamp(p, ivec2(0), full - 1);
    vec3 e = encoded(texelFetch(src, p, 0).rgb);
    float y = dot(e, vec3(0.2126, 0.7152, 0.0722));
    return vec2((e.b - y) / 1.8556, (e.r - y) / 1.5748);
}

void main()
{
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(cbPlane);
    if (gid.x >= size.x || gid.y >= size.y) return;
    ivec2 full = textureSize(src, 0);
    ivec2 step = ivec2(1 << u.chroma.x, 1 << u.chroma.y);
    vec2 sum = vec2(0.0);
    for (int j = 0; j < step.y; ++j) {
        int y = gid.y * step.y + j;
        int x = gid.x * step.x;
        if (step.x == 1)
            sum += colourAt(ivec2(x, y), full);
        else
            sum += 0.25 * colourAt(ivec2(x - 1, y), full) + 0.5 * colourAt(ivec2(x, y), full)
                 + 0.25 * colourAt(ivec2(x + 1, y), full);
    }
    sum /= float(step.y);
    imageStore(cbPlane, gid, vec4(round(512.0 + 896.0 * sum.x) / 65535.0, 0.0, 0.0, 1.0));
    imageStore(crPlane, gid, vec4(round(512.0 + 896.0 * sum.y) / 65535.0, 0.0, 0.0, 1.0));
}
