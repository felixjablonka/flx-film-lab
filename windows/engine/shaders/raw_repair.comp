#version 440
// A pixel without light amid well-lit ones (the demosaic's overshoot beside
// a point of light) takes its eight neighbours' median, channel by channel,
// where their luminance's median is over four times the noise. RawDetail's
// repairOvershoot.

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform sampler2D src;
layout(binding = 1, rgba32f) uniform writeonly image2D dst;
layout(std140, binding = 2) uniform Noise {
    vec4 noise;             // x a, y b: the variance a Y + b
} u;

const vec3 kLuma = vec3(0.2627, 0.6780, 0.0593);

float luminance(vec3 c) { return kLuma.x * c.x + kLuma.y * c.y + kLuma.z * c.z; }
float variance(float y) { return max(1e-12, u.noise.x * max(y, 0.0) + u.noise.y); }

#define SWAP(a, b) { float lo = min(v[a], v[b]); v[b] = max(v[a], v[b]); v[a] = lo; }

// the fifth smallest of eight, as nth_element(v, v + 4, v + 8) leaves at 4
float fifthOfEight(float v[8])
{
    SWAP(0, 1) SWAP(2, 3) SWAP(4, 5) SWAP(6, 7)
    SWAP(0, 2) SWAP(1, 3) SWAP(4, 6) SWAP(5, 7)
    SWAP(1, 2) SWAP(5, 6) SWAP(0, 4) SWAP(3, 7)
    SWAP(1, 5) SWAP(2, 6)
    SWAP(1, 4) SWAP(3, 6)
    SWAP(2, 4) SWAP(3, 5)
    SWAP(3, 4)
    return v[4];
}

void main()
{
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(dst);
    if (gid.x >= size.x || gid.y >= size.y) return;
    vec3 p = texelFetch(src, gid, 0).rgb;
    if (luminance(p) <= 0.0) {
        float l[8], r[8], g[8], b[8];
        int m = 0;
        for (int dy = -1; dy <= 1; ++dy)
            for (int dx = -1; dx <= 1; ++dx) {
                if (dx == 0 && dy == 0)
                    continue;
                vec3 c = texelFetch(src, clamp(gid + ivec2(dx, dy), ivec2(0), size - 1), 0).rgb;
                l[m] = luminance(c);
                r[m] = c.r;
                g[m] = c.g;
                b[m] = c.b;
                ++m;
            }
        float median = fifthOfEight(l);
        if (median > 4.0 * sqrt(variance(median)))
            p = vec3(fifthOfEight(r), fifthOfEight(g), fifthOfEight(b));
    }
    imageStore(dst, gid, vec4(p, 1.0));
}
